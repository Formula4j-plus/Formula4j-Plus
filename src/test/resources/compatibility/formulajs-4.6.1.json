      "referenceExpected": {
        "type": "number",
        "value": "0.30000000000000004"
      },
      "javaExpected": {
        "legacy": {
          "type": "number",
          "value": "0.30000000000000004"
        },
        "strict": {
          "type": "number",
          "value": "0.3"
        }
      },
      "expectedStatus": {
        "legacy": "match",
        "strict": "match"
      }
    },
